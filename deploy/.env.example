# ============================================================
# 翎翼毽球教学平台 —— 环境变量示例
# 使用方式：复制为 .env 后按需修改
#   cp .env.example .env
# 注意：.env 含敏感信息，请勿提交到版本库。
# ============================================================

# ---------- 镜像源 ----------
# 所有镜像与构建基础镜像使用的国内可拉取镜像源前缀
REGISTRY_MIRROR=docker.m.daocloud.io

# ---------- 时区 ----------
TZ=Asia/Shanghai

# ---------- MySQL ----------
# root 密码（仅用于容器内管理，业务不使用 root 连接）
MYSQL_ROOT_PASSWORD=root_change_me
# 业务数据库名（server-go 与 server-java 共用）
MYSQL_DATABASE=lingxi_jianqiu
# 业务数据库账号（mysql 镜像会自动创建该账号并授权到 MYSQL_DATABASE）
MYSQL_USER=lingxi
MYSQL_PASSWORD=lingxi_change_me
# MySQL 映射到宿主机的端口
MYSQL_PORT=3306

# ---------- Redis ----------
# Redis 访问密码（redis-server 启动时启用 requirepass）
REDIS_PASSWORD=redis_change_me
# Redis 映射到宿主机的端口
REDIS_PORT=6379

# ---------- 安全 ----------
# JWT 签名密钥（server-go 使用，生产环境务必改为随机长字符串）
JWT_SECRET=please_change_this_jwt_secret

# ---------- DeepSeek AI ----------
# DeepSeek API Key（留空则 AI 相关功能不可用，不影响其他功能启动）
DEEPSEEK_API_KEY=
# DeepSeek API 基础地址（官方 https://api.deepseek.com 即可，带 /v1 亦可）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- 前端对外端口 ----------
# 学生端（宿主机端口 -> 容器 80）
STUDENT_WEB_PORT=8080
# 教师端（宿主机端口 -> 容器 80）
TEACHER_WEB_PORT=8081
