# 统一换行符，避免 Windows 检出后脚本 / 配置在 WSL、Podman 中失效
* text=auto eol=lf

# Shell 脚本必须保持 LF，否则在 WSL / 容器内执行报 "bad interpreter"
*.sh            text eol=lf
*.bash          text eol=lf

# 容器与配置文件
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.ts            text eol=lf
*.vue           text eol=lf
*.go            text eol=lf
*.py            text eol=lf
*.xml           text eol=lf

# Windows 批处理保持 CRLF
*.bat           text eol=crlf
*.cmd           text eol=crlf

# 二进制文件不做换行符转换
*.mp4           binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.woff          binary
*.woff2         binary
*.ttf           binary
*.glb           binary
*.fbx           binary
*.pt            binary
